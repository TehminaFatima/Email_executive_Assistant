    {
      "parameters": {
        "jsCode": "const email = $input.item.json;\nconst binary = $input.item.binary || {};\n\nconst stripSignature = (body) => {\n  if (!body) return '';\n  return body.split(/(--\\s*$|Sent from my|Best regards|Regards,|Thanks,)/i)[0].trim();\n};\n\nconst attachments = Object.keys(binary).map(key => ({\n  filename: binary[key].fileName || key,\n  mimeType: binary[key].mimeType || '',\n  key\n}));\n\nreturn {\n  json: {\n    threadId: email.threadId,\n    messageId: email.id,\n    from: (email.from && email.from.value && email.from.value[0] && email.from.value[0].address) || email.from || '',\n    fromName: (email.from && email.from.value && email.from.value[0] && email.from.value[0].name) || '',\n    subject: email.subject || '(no subject)',\n    bodyRaw: email.text || email.html || '',\n    bodyClean: stripSignature(email.text || ''),\n    hasAttachments: attachments.length > 0,\n    attachmentNames: attachments.map(a => a.filename),\n    receivedAt: email.date,\n    isReply: /^re:/i.test(email.subject || '')\n  },\n  binary: binary\n};"
      },
